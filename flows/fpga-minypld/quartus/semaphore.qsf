# =====================================================================
#  semaphore.qsf  ·  Proyecto Quartus para la MinyPLD (Altera/Intel MAX V)
#  Capsula 5 (Mazapan / FPGA-CPLD).
#  Pinout real de la tarjeta MinyPLD de Cesar (5M80ZE64C5).
# =====================================================================

set_global_assignment -name FAMILY "MAX V"
set_global_assignment -name DEVICE 5M80ZE64C5
set_global_assignment -name TOP_LEVEL_ENTITY top_minypld

# ---- Fuentes (el mismo RTL compartido en common/) -------------------
set_global_assignment -name VERILOG_FILE ../../../common/rtl/semaphore/rtl/top_minypld.v
set_global_assignment -name VERILOG_FILE ../../../common/rtl/semaphore/rtl/clk_divider.v
set_global_assignment -name VERILOG_FILE ../../../common/rtl/semaphore/rtl/semaphore.v
set_global_assignment -name SDC_FILE semaphore.sdc

# ---- Asignacion de pines (REAL, MinyPLD 5M80ZE64C5) -----------------
set_location_assignment PIN_7  -to clk
set_location_assignment PIN_21 -to rst_n
set_location_assignment PIN_62 -to led_red
set_location_assignment PIN_63 -to led_yellow
set_location_assignment PIN_64 -to led_green

# ---- Estandar de E/S ------------------------------------------------
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to clk
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to rst_n
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to led_red
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to led_yellow
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to led_green

# ---- Seguridad: pines no usados como entrada tri-estado -------------
set_global_assignment -name RESERVE_ALL_UNUSED_PINS "AS INPUT TRI-STATED"
set_global_assignment -name USE_CONFIGURATION_DEVICE ON